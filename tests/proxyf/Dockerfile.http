FROM golang:1.26-alpine@sha256:ce864e7223ac17b1775e6fd0b4c0db580c2eb50e7953a427916379e4b92a1628 AS build
COPY main.go /src/main.go
RUN CGO_ENABLED=0 go build -trimpath -o /out/http-fixture /src/main.go
FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40
COPY --from=build /out/http-fixture /usr/local/bin/http-fixture
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/http-fixture"]
